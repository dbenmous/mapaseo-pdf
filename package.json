{
  "name": "mapaseo-pdf",
  "version": "1.1.0",
  "private": true,
  "description": "A precise, private PDF workspace for Windows and macOS.",
  "author": "Mapaseo",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/copy-pdf-assets.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "desktop:dev": "electron . --dev",
    "test": "vitest run",
    "prepackage": "node scripts/third-party-notices.mjs",
    "package": "npm run build && electron-builder --win portable --x64",
    "prepackage:installer": "node scripts/third-party-notices.mjs",
    "package:installer": "npm run build && electron-builder --win nsis --x64",
    "test:ui": "playwright test",
    "test:desktop": "node tests/electron-smoke.cjs",
    "test:layout:desktop": "node tests/desktop-layout.cjs",
    "package:mac": "node scripts/package-mac.mjs",
    "test:mac": "node tests/mac-smoke.cjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.mapaseo.pdf",
    "productName": "Mapaseo PDF",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "THIRD_PARTY_LICENSES.txt",
      "!node_modules/**"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "electron/mapaseo.ico",
      "artifactName": "Mapaseo-PDF-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Mapaseo-PDF-Portable-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "Mapaseo-PDF-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF document",
        "role": "Editor"
      }
    ],
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "electron/mapaseo.icns",
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": true,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist",
      "notarize": false,
      "artifactName": "Mapaseo-PDF-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "sign": false
    }
  }
}
